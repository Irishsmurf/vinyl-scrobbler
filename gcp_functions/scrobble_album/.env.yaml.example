# Environment variables for the ScrobbleAlbum function.
#
# Copy this file to `.env.yaml` (which is git-ignored) and fill in your
# Last.fm credentials. The deploy script passes it via `--env-vars-file`,
# which handles values containing commas or special characters safely.
#
#   cp .env.yaml.example .env.yaml
#
LASTFM_API_KEY: "your_lastfm_api_key"
LASTFM_API_SECRET: "your_lastfm_shared_secret"
LASTFM_SESSION_KEY: "your_lastfm_session_key"
