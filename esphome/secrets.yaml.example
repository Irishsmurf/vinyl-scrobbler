# Copy to secrets.yaml (or add these entries via the ESPHome Device Builder's
# "Secrets" editor) and fill in real values. This replaces the Arduino
# sketch's credentials.h.

wifi_ssid: "your_wifi_ssid"
wifi_password: "your_wifi_password"

# Password for the fallback hotspot the device opens when Wi-Fi fails
fallback_ap_password: "choose_a_password"

# MQTT broker credentials (same values as MQTT_USER / MQTT_PASSWORD in credentials.h)
mqtt_user: "your_mqtt_username"
mqtt_password: "your_mqtt_password"

# Generate with: openssl rand -base64 32
# (or let the ESPHome Device Builder generate one when adopting the device)
api_encryption_key: "32-byte-base64-key-goes-here="

# Password required for over-the-air firmware updates
ota_password: "choose_a_password"
